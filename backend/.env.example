# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Direct host db.<ref>.supabase.co is IPv6-only. On an IPv4 network, use the
# session pooler from the Connect dialog (port 5432, user postgres.<ref>).
# Do not use port 6543 (transaction mode). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- NVIDIA NIM (embeddings + chat) ---

# Key: https://build.nvidia.com/settings
# The embedding model returns 2048 dimensions. Requests ask for 1536, which
# matches document_chunks.embedding. Indexing uses input_type=passage and
# questions use input_type=query, so chunks embedded another way must be redone.
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
# Fast agent model: tool calling and structured output. The smaller chat model
# is nvidia/nemotron-3.5-bolt-e4b.
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
