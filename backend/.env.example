# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Direct host db.<ref>.supabase.co is IPv6-only. On an IPv4 network, use the
# session pooler from the Connect dialog (port 5432, user postgres.<ref>).
# Do not use port 6543 (transaction mode). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- OpenRouter (chunk embeddings) ---

# Free embedding route. The model returns 2048 dimensions; ingestion stores
# the first 1536, L2-normalized, to match document_chunks.embedding.
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
